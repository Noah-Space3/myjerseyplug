# MyJerseyPlug — environment variables
# Copy to .env.local and fill in your Supabase project keys.
# Without these, the app runs in demo mode (localStorage + in-memory orders).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
